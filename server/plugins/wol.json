                    {"label": "唤醒", "endpoint": "/proxy/wol/api/wake", "method": "POST",
                     "paramFrom": "$.mac", "paramKey": "mac"}
                  ]}},
        {"type": "keyvalue", "title": "说明", "items": ["$.ok"]}
      ]
    }
  ]
}
