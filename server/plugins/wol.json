{
  "id": "wol",
  "name": "网络唤醒",
  "tag": "运维",
  "icon": "⚡",
  "color": "#f43f5e",
  "desc": "Wake-on-LAN 设备列表，一键发送魔法包唤醒",
  "type": "native",
  "pages": [
    {
      "title": "设备",
      "layout": [
