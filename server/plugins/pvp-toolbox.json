{
  "id": "pvp-toolbox",
  "name": "CS 战绩工具箱",
  "tag": "游戏",
  "icon": "🎯",
  "color": "#ef4444",
  "desc": "CS2 战绩总览、最近对局与全部数据同步操作",
  "type": "native",
  "pages": [
    {
      "title": "战绩",
      "layout": [
        {"type": "stats", "title": "总览", "endpoint": "/proxy/pvp/api/summary", "refresh": 60, "items": [
          {"label": "总场次", "value": "$.total"},
          {"label": "胜率", "value": "$.win_rate"},
          {"label": "K/D", "value": "$.kd"},
          {"label": "KDA", "value": "$.kda"},
          {"label": "总击杀", "value": "$.kills"},
          {"label": "平均评分", "value": "$.avg_rating"}
        ]},
        {"type": "list", "title": "最近对局", "endpoint": "/proxy/pvp/api/matches?limit=10", "refresh": 60,
         "item": {"title": "$.map", "subtitle": "$.mode", "value": "$.score"}}
      ]
    },
    {
      "title": "账号",
      "layout": [
        {"type": "keyvalue", "title": "账号信息", "endpoint": "/proxy/pvp/api/status", "refresh": 60, "items": [
          "$.nickname", "$.steam_id", "$.matches", "$.demo_archive", "$.details_localized"
        ]},
        {"type": "actions", "title": "数据刷新", "actions": [
          {"label": "快速同步（战绩列表）", "endpoint": "/proxy/pvp/api/matches/refresh", "method": "POST",
           "body": {"full": false}},
          {"label": "全量同步（含详情）", "endpoint": "/proxy/pvp/api/matches/refresh", "method": "POST",
           "body": {"full": true}, "confirm": "全量同步耗时较长，确定执行吗？"},
          {"label": "扫描本地 Demo", "endpoint": "/proxy/pvp/api/demo/scan", "method": "GET"},
          {"label": "刷新精彩时刻", "endpoint": "/proxy/pvp/api/moments/refresh", "method": "POST"},
          {"label": "夜间同步", "endpoint": "/proxy/pvp/api/sync/nightly", "method": "POST",
           "confirm": "立即执行夜间同步任务吗？"}
        ]}
      ]
    }
  ]
}
