{
  "id": "qbittorrent",
  "name": "qBittorrent 下载",
  "tag": "下载",
  "icon": "📥",
  "color": "#f59e0b",
  "desc": "BT/磁力任务管理：行级暂停/恢复、全局操作、添加种子",
  "type": "native",
  "pages": [
    {
      "title": "任务",
      "layout": [
        {"type": "list", "title": "下载任务", "endpoint": "/proxy/qbt/api/v2/torrents/info", "refresh": 5,
         "listPath": "$",
         "item": {"title": "$.name", "subtitle": "$.state", "value": "$.dlspeed", "valueUnit": "B/s",
                  "actions": [
                    {"label": "暂停", "endpoint": "/proxy/qbt/api/v2/torrents/pause", "method": "POST",
                     "encoding": "form", "paramFrom": "$.hash", "paramKey": "hashes"},
                    {"label": "恢复", "endpoint": "/proxy/qbt/api/v2/torrents/resume", "method": "POST",
                     "encoding": "form", "paramFrom": "$.hash", "paramKey": "hashes"}
                  ]}},
        {"type": "actions", "title": "全局操作", "actions": [
          {"label": "全部暂停", "endpoint": "/proxy/qbt/api/v2/torrents/pause", "method": "POST",
           "encoding": "form", "body": {"hashes": "all"},
           "confirm": "确定暂停全部下载任务吗？", "style": "danger"},
          {"label": "全部恢复", "endpoint": "/proxy/qbt/api/v2/torrents/resume", "method": "POST",
           "encoding": "form", "body": {"hashes": "all"}}
        ]}
      ]
    },
    {
      "title": "添加",
      "layout": [
        {"type": "upload", "title": "上传种子文件（.torrent）", "endpoint": "/proxy/qbt/api/v2/torrents/add",
         "fileParam": "torrents", "accept": "file"}
      ]
    }
  ]
}
